# ==============================================================================
# SAKOON TEMPLE — ENVIRONMENT CONFIGURATION (.env.example)
# Copy this file to .env and fill in your actual credentials.
# NOTE: The .env file is strictly ignored by Git and will NEVER be pushed.
# ==============================================================================

# Node Environment
NODE_ENV=development

# Cloudflare Worker API URL (For YouTube Live Darshan stream caching)
CLOUDFLARE_WORKER_URL=https://sakoon-temple-live-darshan.YOUR_SUBDOMAIN.workers.dev

# YouTube Data API v3 Key (Used only inside Cloudflare Worker, never in browser)
YOUTUBE_API_KEY=YOUR_YOUTUBE_API_KEY_HERE
YOUTUBE_CHANNEL_ID=YOUR_YOUTUBE_CHANNEL_ID_HERE

